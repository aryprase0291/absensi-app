# Salin file ini menjadi `.env.local` (nama itu sudah di-ignore git).
#
#   cp .env.local.example .env.local
#
# Lalu isi URL deployment Apps Script dari spreadsheet SALINAN untuk uji coba.
# Panduan membuat salinan yang aman: lihat SETUP-LOCAL.md
#
# Kalau baris di bawah dikosongkan atau file ini tidak ada, aplikasi akan
# tersambung ke backend PRODUKSI — data asli ikut berubah.

REACT_APP_SCRIPT_URL=

# Perpanjang auto-logout selama development (satuan menit, default 5).
REACT_APP_TIMEOUT_MINUTES=120

# ============================================================
# SUPABASE (FASE 1 — LOGIN)
#
# Selama kedua baris ini kosong, login tetap lewat Apps Script dan tidak
# ada yang berubah. Isi hanya kalau Anda memang sedang menguji jalur baru.
#
# Kunci `anon` aman berada di sisi klien: seluruh tabel memakai RLS tanpa
# policy, jadi kunci ini tidak bisa membaca apa pun secara langsung.
# ============================================================
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
