# =====================================================================
# ATURAN CACHE — INI AKAR MASALAH "LAYAR PUTIH" DAN "UPDATE TERSEDIA
# BERULANG" DI HP (8 Sep 2026)
#
# Berkas di /static/ namanya mengandung hash isi (main.80265044.js).
# Isinya tidak pernah berubah tanpa berganti nama, jadi AMAN disimpan
# selamanya di HP.
#
# index.html sebaliknya: namanya selalu sama, tapi isinya berubah setiap
# rilis karena ia yang menunjuk bundle mana yang dipakai. Kalau HP
# menyimpannya, dua hal terjadi:
#   - index.html lama menunjuk /static lama yang sudah diganti -> 404,
#     yang terlihat karyawan sebagai LAYAR PUTIH;
#   - bundle lama melapor versi lama ke server yang sudah baru ->
#     layar "Update Tersedia" yang tidak pernah selesai.
#
# Berkas ini otomatis ikut tersalin ke folder build saat npm run build.
# Kalau hosting Anda memakai Nginx (bukan Apache), berkas ini diabaikan —
# lihat GPS-TRACKING.md untuk padanan konfigurasinya.
# =====================================================================

<IfModule mod_headers.c>
  # HTML & manifest: selalu ambil ulang dari server.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Aset ber-hash: simpan selamanya, tidak perlu ditanyakan lagi.
  <FilesMatch "^(main|[0-9]+)\.[a-f0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Model & pustaka deteksi wajah: besar dan jarang berubah.
  # Aturan ini harus SESUDAH blok .json di atas supaya manifest model
  # tidak ikut kena "no-store".
  <FilesMatch "(weights_manifest\.json|\.bin)$">
    Header set Cache-Control "public, max-age=2592000"
    Header unset Pragma
  </FilesMatch>
  <FilesMatch "^face-api\.js$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  # Bobot model face-api (.bin) harus dikirim apa adanya.
  AddType application/octet-stream .bin
</IfModule>
